# Philippine Exam Reviewer Platform (.env.example)
# Fill in real values in .env.local for local dev, or configure in Vercel Project Settings for deployment.
# NEVER commit secrets.

# ==============================================================================
# Database (PostgreSQL / Neon / Supabase / Vercel Postgres)
# ==============================================================================
# Connection string: csereviewph.com supports either DATABASE_URL or POSTGRES_URL.
# If connecting to Neon or Supabase, SSL is automatically negotiated with rejectUnauthorized: false.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/csereviewer"
# POSTGRES_URL="" # Automatically provided if using Vercel Postgres / Neon marketplace integration

# Maximum connection pool size per serverless lambda (defaults to 5 if unset)
DB_POOL_MAX="5"

# ==============================================================================
# Application & Authentication
# ==============================================================================
# Canonical public URL (e.g., https://www.reviewtayo.online).
# In production on Vercel, set to https://www.reviewtayo.online
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth Configuration
BETTER_AUTH_SECRET="placeholder-secret-at-least-32-chars-long-123456"
BETTER_AUTH_URL="http://localhost:3000"

# ==============================================================================
# Analytics & Monitoring (Consent-gated per RA 10173)
# ==============================================================================
# PostHog Analytics (self-hostable / cloud)
NEXT_PUBLIC_POSTHOG_KEY="phc_placeholder_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=""

# ==============================================================================
# Monetization & Advertising (Google AdSense)
# ==============================================================================
# AdSense Setup Flow (Standard 5-Step Order):
# 1. Create or sign into your Google AdSense account and obtain your Publisher ID (ca-pub-XXXXXXXXXXXXXXXX).
# 2. Add NEXT_PUBLIC_ADSENSE_CLIENT_ID below. This injects the verification script/meta tag to verify site ownership.
# 3. Publish the corresponding real ads.txt record (automatically generated at /ads.txt from NEXT_PUBLIC_ADSENSE_CLIENT_ID).
# 4. Request site review in Google AdSense.
# 5. Once reviewed and site is approved:
#    - Obtain real numeric ad unit slot IDs from AdSense (Ads > By ad unit) and configure them below.
#    - AUTO ADS POLICY: Turn Auto Ads OFF in the AdSense console (Ads > By site > Auto ads = OFF)
#      to preserve ReviewTayo's strict manual placement strategy. If Auto ads is left on, configure Page
#      Exclusions in AdSense for: /exams/*, /practice/*, /results/*, /dashboard/*, /settings/*,
#      /sign-in, /create-account, /forgot-password, /contact, /privacy, /terms, and /disclaimer.
#    - For EEA, UK, and Switzerland traffic: Enable Google Privacy & Messaging (GDPR message) in the
#      AdSense console to meet Google's certified CMP / IAB TCF v2.3 requirement.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
# ADSENSE_PUB_ID="" # Optional override for /ads.txt if different

# Real numeric ad unit slot IDs (issued in Google AdSense > Ads > By ad unit)
NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE=""
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLES=""
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_DETAIL=""
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES=""
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE_DETAIL=""
NEXT_PUBLIC_ADSENSE_SLOT_FAQ=""
NEXT_PUBLIC_ADSENSE_SLOT_EXAM_INFO=""
NEXT_PUBLIC_ADSENSE_SLOT_PRACTICE=""

# ==============================================================================
# Operations & Maintenance (Contact, Retention, & Admin)
# ==============================================================================
# Secret for authenticating automated retention cleanup cron jobs (/api/cron/cleanup-contact)
CRON_SECRET=""

# Secret key for operator review of contact inquiries (/api/admin/inquiries)
ADMIN_API_KEY=""

# Dedicated random secret (at least 32 characters) used only to pseudonymize
# contact-form IP addresses for cross-instance rate limiting. Do not reuse auth secrets.
CONTACT_IP_HASH_SALT=""

# Optional webhook URL to receive instant alerts when a user submits an inquiry
# Notifications contain only the reference ID and category; operators retrieve PII through the protected admin API.
CONTACT_WEBHOOK_URL=""

